BOT_TOKEN=
GROQ_API_KEY=

# Redis connection URL for session persistence
# For local dev: redis://localhost:6379 (requires Redis running)
# For production: Use managed Redis (AWS ElastiCache, Redis Cloud, etc.)
# Leave empty to use default (localhost:6379)
REDIS_URL=

# Optional Mini App URL — must be public https:// (Telegram does not open http://localhost)
# Local dev: run Next.js, then use ngrok / Cloudflare Tunnel and paste the https URL here.
MINI_APP_URL=

# URLs used in guides (override if your portal paths differ)
BASE_URL=https://gojohost.net
CLIENT_AREA_URL=https://gojohost.net/client-area
CPANEL_URL_HINT=https://gojohost.net/cpanel-login
WEBMAIL_URL_HINT=https://webmail.yourdomain.com

# Support contacts (shown in guides and /support)
SUPPORT_EMAIL=support@gojohost.net
SUPPORT_PHONE=+251940248788
SUPPORT_TELEGRAM=@GojoHostSupport

# Optional: domain checker link for /domain
DOMAIN_PORTAL_URL=https://gojohost.net
